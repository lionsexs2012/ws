# Сервер
PORT=3000
NODE_ENV=production

# База данных (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wond_db
DB_USER=wond_user
DB_PASSWORD=wond_password

# Redis (Кеш)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=wond-super-secret-key-2026-change-in-production
JWT_EXPIRES_IN=7d

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# CORS
CORS_ORIGIN=https://wond.onrender.com

# Rate Limit
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
